<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Terms &amp; Conditions"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:paddingBottom="12dp"/>

        <!-- Last updated -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last updated: April 2026"
            android:textSize="12sp"
            android:textColor="#777777"
            android:paddingBottom="16dp"/>

        <!-- Content Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Acceptance of Terms"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#111111"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="By using this Grocery Notifier app, you agree to follow all rules and conditions stated in this document."
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. User Accounts"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#111111"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You are responsible for maintaining the confidentiality of your account and data. Sharing accounts is not recommended."
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Data Usage"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#111111"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="We store your data locally using Room database. No personal data is shared with third parties."
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Changes"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#111111"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="We may update these terms at any time. Continued use of the app means you accept the updated terms."
                android:textSize="14sp"
                android:textColor="#444444"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>